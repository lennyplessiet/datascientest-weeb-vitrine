# Sentry (surveillance des erreurs en production)
# Ce DSN est public par conception (il est embarqué dans le bundle client).
# Laissez vide pour désactiver Sentry (le site fonctionne sans).
VITE_SENTRY_DSN=

# Optionnel : nom d'environnement affiché dans Sentry (« production », « preview », …).
# Par défaut Vite utilise son mode (production en build).
VITE_SENTRY_ENVIRONMENT=

# Optionnel : taux d'échantillonnage des traces de performance, entre 0 et 1.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
